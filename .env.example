# ==============================================================================
# SISTEMA DE INFORMACIÓN IDF - DNP (DEPARTAMENTO NACIONAL DE PLANEACIÓN)
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Instrucciones de despliegue:
# 1. Copie este archivo como '.env' en el entorno de destino (servidor, contenedor o local):
#      cp .env.example .env   (Linux/macOS)
#      copy .env.example .env (Windows)
# 2. Ajuste las variables de acuerdo a la configuración del servidor de base de datos.
# ==============================================================================

# Motor de Base de Datos principal: 'mysql' (producción/central) o 'sqlite' (local)
DB_ENGINE=mysql

# Parámetros de Conexión MySQL / MariaDB (MySQL Workbench o Servidor Institucional)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=idf

# Parámetros del Servidor Web FastAPI
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=False
